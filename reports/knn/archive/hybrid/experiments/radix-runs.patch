+// Point boxes can use fixed Morton runs without materializing N singleton
+// leaves. Keep a spatial radix topology over the runs: splitting them at fixed
+// ranks instead would create overlapping boxes on nonuniform point clouds.
+__global__ void build_point_runs(
+    int num_leaves,
+    int num_items,
+    int leaf_size,
+    const uint32_t* point_keys,
+    uint32_t* run_keys,
+    BVHPackedNodeHalf* lowers,
+    BVHPackedNodeHalf* uppers
+)
+{
+    const int node = blockIdx.x * blockDim.x + threadIdx.x;
+    if (node >= num_leaves)
+        return;
+    const int start = node * leaf_size;
+    const int end = start + min(leaf_size, num_items - start);
+    bounds3 bounds;
+    lowers[node] = make_node(bounds.lower, start, true);
+    uppers[node] = make_node(bounds.upper, end, false);
+    run_keys[node] = point_keys[start];
+}
+
+// Equal Morton keys add index-prefix bits to a radix path. Collapse unusually
+// deep subtrees so ordinary BVH queries retain their fixed stack guarantee.
+__global__ void limit_point_run_depth(
+    int num_leaves,
+    int num_items,
+    int leaf_size,
+    const uint32_t* run_keys,
+    const int* range_lefts,
+    const int* range_rights,
+    const int* parents,
+    BVHPackedNodeHalf* lowers,
+    BVHPackedNodeHalf* uppers
+)
+{
+    const int node = num_leaves + blockIdx.x * blockDim.x + threadIdx.x;
+    if (node >= 2 * num_leaves - 1)
+        return;
+    const int first = range_lefts[node], last = range_rights[node];
+    if (radix_prefix(run_keys, num_leaves, first, last) - radix_prefix(run_keys, num_leaves, 0, num_leaves - 1) + 1
+        < BVH_QUERY_STACK_SIZE)
+        return;
+    int depth = 1, parent = parents[node];
+    while (parent != -1 && depth < BVH_QUERY_STACK_SIZE) {
+        parent = parents[parent];
+        ++depth;
+    }
+    if (depth >= BVH_QUERY_STACK_SIZE) {
+        lowers[node].b = 1;
+        lowers[node].i = first * leaf_size;
+        // Avoid overflowing the product for a partial last run.
+        const int end_start = last * leaf_size;
+        uppers[node].i = end_start + min(leaf_size, num_items - end_start);
+    }
+}
