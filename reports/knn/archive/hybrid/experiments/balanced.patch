+// Point boxes can use fixed Morton runs, as in a balanced Morton tree. Build
+// only O(N / leaf_size) nodes instead of building N leaves and then muting them.
+// Reverse heap indices put every leaf first, as required by the refit kernel.
+__global__ void build_point_runs(
+    int num_nodes,
+    int num_leaves,
+    int num_items,
+    int leaf_size,
+    int* root,
+    int* parents,
+    BVHPackedNodeHalf* lowers,
+    BVHPackedNodeHalf* uppers
+)
+{
+    const int node = blockIdx.x * blockDim.x + threadIdx.x;
+    if (node >= num_nodes)
+        return;
+    parents[node] = node == num_nodes - 1 ? -1 : num_leaves + node / 2;
+    if (node < num_leaves) {
+        // Padding leaves have an empty range and inverted bounds.
+        const int start = int(min(int64_t(num_leaves - 1 - node) * leaf_size, int64_t(num_items)));
+        const int end = start + min(leaf_size, num_items - start);
+        bounds3 bounds;
+        lowers[node] = make_node(bounds.lower, start, true);
+        uppers[node] = make_node(bounds.upper, end, false);
+    } else {
+        const int left = 2 * (node - num_leaves) + 1;
+        lowers[node] = make_node(vec3(0.0f), left, false);
+        uppers[node] = make_node(vec3(0.0f), left - 1, false);
+    }
+    if (node == num_nodes - 1)
+        *root = node;
+}
